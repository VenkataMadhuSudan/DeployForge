# DeployForge Environment Configuration
# IMPORTANT: Never commit production values or secrets to source control.

# Application Environment
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
PUBLIC_APP_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000

# PostgreSQL Database Connection
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
DATABASE_URL=postgresql://deployforge:deployforge_secret@localhost:5432/deployforge_db?schema=public

# Redis Connection for BullMQ
# For cloud Redis (Upstash, Redis Cloud), set REDIS_TLS=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# Session / JWT Authentication
JWT_SECRET=replace_with_a_secure_random_jwt_secret_at_least_32_chars_long
JWT_EXPIRES_IN=7d
SESSION_SECRET=replace_with_a_secure_random_session_secret_at_least_32_chars

# Data Encryption at Rest (AES-256-GCM)
# 64-character hexadecimal string representing 32 bytes
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# GitHub App Integration
GITHUB_APP_ID=
GITHUB_APP_SLUG=deployforge
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=replace_with_github_webhook_secret_for_signature_verification
# PEM-formatted RSA private key for GitHub App authentication (Base64 encoded or path)
GITHUB_PRIVATE_KEY=

# Hosting Provider Configuration
# Supported providers: LOCAL_TESTING, CLOUDFLARE_PAGES, AWS_S3
HOSTING_PROVIDER=LOCAL_TESTING

# Cloudflare Pages Adapter Settings (Optional if using LOCAL_TESTING)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Build Sandbox Resource Limits
BUILD_TIMEOUT_SECONDS=600
BUILD_MEMORY_LIMIT_MB=1024
BUILD_CPU_LIMIT=1.0
BUILD_MAX_PROCESSES=100
BUILD_WORKSPACE_DIR=./storage/workspaces
ARTIFACT_STORAGE_DIR=./storage/artifacts
LOCAL_DEPLOYMENT_PORT=8080

# Logging & Telemetry
LOG_LEVEL=info
